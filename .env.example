# WebSocket server URL used by the browser client
# Local:
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Production (example after Render deploy):
# NEXT_PUBLIC_WS_URL=https://agnos-patient-portal-socket.onrender.com

# Socket server port (Render sets PORT automatically)
SOCKET_PORT=3001

# Allowed browser origins for Socket.IO CORS (comma-separated)
# Local + Netlify example:
CLIENT_ORIGIN=http://localhost:3000
# CLIENT_ORIGIN=http://localhost:3000,https://YOUR-SITE.netlify.app
